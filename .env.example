# Required in production. Long random strings (e.g. `openssl rand -hex 32`).
# The first Super Admin is created from these the first time anyone signs in.
ADMIN_EMAIL=owner@your-domain.example
ADMIN_PASSWORD=change-me-krip-admin
SESSION_SECRET=replace-with-64-hex-chars

# Payments. Leave PAYMENT_PROVIDER unset to run the clearly-labelled demo gateway.
# A real provider (e.g. Razorpay/Cashfree/PayU) must be wired in src/lib/payments.ts
# and confirm payments only through its signed server-side webhook.
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
DEMO_PAYMENTS=true

# Back-in-stock alerts are only offered when a notification service is connected.
NOTIFY_PROVIDER=

# Where the JSON datastore lives (prototype only — use a real database in production).
KRIP_DATA_DIR=.data
GEOCODE_PROVIDER=nominatim
GEOCODE_USER_AGENT=krip-storefront (contact@your-domain.example)
